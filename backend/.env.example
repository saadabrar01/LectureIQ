DATABASE_URL=postgresql://user:password@localhost:5432/lecture_iq
CORS_ORIGINS=*

# --- RAG / AI ---
# LLM provider: groq | openai (Groq serves chat only, not embeddings)
LLM_PROVIDER=groq
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b

# Embeddings: set OPENAI_API_KEY to enable semantic embeddings.
# Empty = offline feature-hashing fallback (lexical similarity).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
