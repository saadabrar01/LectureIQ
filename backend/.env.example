# Database configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/lecture_iq

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,exp://localhost:8081

# Security & JWT
JWT_SECRET=your-random-32-byte-hex-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG & AI Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
CHAT_MODEL=openai/gpt-oss-120b

# Optional: OpenAI API Key (for OpenAI Whisper or text-embedding-3-small embeddings)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
